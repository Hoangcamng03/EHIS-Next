# Copy to .env.local. This is client configuration, not admin credentials.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-ehis-next
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_APP_ID=demo-app
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ehis-next.firebaseapp.com
EXPO_PUBLIC_USE_EMULATORS=true
# Use your laptop's LAN address on a physical phone; localhost refers to the phone.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_HEALTH_URL=http://127.0.0.1:5101/demo-ehis-next/asia-southeast1/health
