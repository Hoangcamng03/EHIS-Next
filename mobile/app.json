{
  "expo": {
    "name": "EHIS Next",
    "slug": "ehis-next",
    "scheme": "ehis-next",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hoangcamng.ehisnext"
    },
    "android": {
      "package": "com.hoangcamng.ehisnext",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-location", { "locationWhenInUsePermission": "EHIS dùng vị trí khi bạn bật sẵn sàng để tìm yêu cầu hỗ trợ gần bạn." }]
    ]
  }
}
