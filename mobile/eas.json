{
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" }
    },
    "production": {
      "developmentClient": false,
      "autoIncrement": true,
      "environment": "production",
      "android": { "buildType": "app-bundle" }
    }
  }
}
