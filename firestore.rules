rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profiles are saved through a validated callable Function.
    match /patients/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }
    // Roles and verification can never be set by a client.
    match /users/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /volunteers/{uid} {
      allow read: if owner(uid);
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
