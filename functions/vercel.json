{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": { "api/index.js": { "maxDuration": 60, "includeFiles": "lib/**" } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api?route=/$1" }],
  "crons": [{ "path": "/internal/maintenance", "schedule": "0 0 * * *" }]
}
