{
  "expo": {
    "name": "EHIS Next",
    "slug": "ehis-next",
    "scheme": "ehis-next",
    "version": "0.4.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hoangcamng.ehisnext",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.hoangcamng.ehisnext",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "runtimeVersion": {
        "policy": "fingerprint"
      },
      "versionCode": 6
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EHIS dùng vị trí khi bạn bật sẵn sàng để tìm yêu cầu hỗ trợ gần bạn."
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "eb11cc2d-e7b9-46ed-8794-0eae2b3495ed"
      }
    },
    "owner": "ehiss-team",
    "updates": {
      "url": "https://u.expo.dev/eb11cc2d-e7b9-46ed-8794-0eae2b3495ed",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
